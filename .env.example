# Optional fallback API key for requests that send no key.
# Normally you enter your Portkey / AI Sandbox key directly in the Copilot
# app's model provider settings; the proxy forwards it per request.
# PORTKEY_API_KEY=

# Optional: override the upstream gateway base URL (defaults to https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: route each alias to a different upstream model/deployment.
# GPT56_SOL_UPSTREAM_MODEL=gpt-5.6-sol
# GPT56_TERRA_UPSTREAM_MODEL=gpt-5.6-terra
# GPT56_LUNA_UPSTREAM_MODEL=gpt-5.6-luna
# GPT6_ASTRA_UPSTREAM_MODEL=gpt-6-astra
# GEMINI38_FLASH_UPSTREAM_MODEL=gemini-3.8-flash
# CLAUDE_OPUS_55_UPSTREAM_MODEL=claude-opus-5-5
# CLAUDE_SONNET_55_UPSTREAM_MODEL=claude-sonnet-5-5
# CLAUDE_FABLE_51_UPSTREAM_MODEL=claude-fable-5-1

# Optional: where the proxy listens.
# PROXY_HOST=127.0.0.1
# PROXY_PORT=8090

# Optional: per-request upstream timeout sent to the Portkey gateway, in
# MILLISECONDS (e.g. 300000 = 5 minutes). Leave unset to use the gateway
# default. Never use seconds here: 600 would mean 600 ms and requests would
# time out immediately.
# PORTKEY_TIMEOUT_MS=300000

# Ask for token usage in streaming responses (set to 0 to disable).
# INCLUDE_STREAM_USAGE=1

# Serve POST /v1/responses (the OpenAI Responses API, backed by the SDK's
# client.responses.create — verified working on the AI Sandbox). Set to 0 to
# disable it, in which case the route answers with a 404 stub.
# RESPONSES_ENABLED=1

# When function tools are present, adjust the reasoning params — but only for
# models whose upstream rejects tools + reasoning (the GPT-5.6 family). If the
# upstream still rejects the request, the other variant is tried once
# automatically. Options: strip (default) | none | keep.
# TOOLS_REASONING_EFFORT=strip

# Serve chat-completions requests that carry function tools through the
# Responses API, translating the reply back into chat.completion shape. The
# gpt-6 family (gpt-6-astra, gpt-6.1-sol) rejects tools on /v1/chat/completions
# in every possible shape, so without this those models cannot tool-call at all.
#   auto   - only models with no working chat shape for tools (default)
#   always - also the GPT-5.6 family, which keeps its reasoning intact instead
#            of having it stripped
#   never  - no bridging; the upstream 400 is forwarded to the client
# Requires RESPONSES_ENABLED=1. Bridged calls log as
# "chat request bridged via responses: ...".
# TOOLS_VIA_RESPONSES=auto

# Per-model reasoning_effort vocabularies. gpt-6-astra rejects 'none'
# (supported: low, medium, high, xhigh), so unsupported client values are
# rewritten to the first non-'none' entry here. gemini-3.8-flash,
# claude-opus-5-5, claude-sonnet-5-5 and claude-fable-5-1 forward client values
# untouched unless you set an explicit list.
# GPT6_ASTRA_REASONING_EFFORTS=low,medium,high,xhigh
# GEMINI38_FLASH_REASONING_EFFORTS=
# CLAUDE_OPUS_55_REASONING_EFFORTS=
# CLAUDE_SONNET_55_REASONING_EFFORTS=
# CLAUDE_FABLE_51_REASONING_EFFORTS=

# --- Usage & cost tracking (usage.py / GET /v1/usage / usage_report.py) ---
# Record token usage and dollar cost for every request to usage.jsonl.
# Set to 0 to disable.
# USAGE_TRACKING=1
# Where the JSONL usage log lives (default: usage.jsonl next to proxy.py).
# USAGE_LOG_PATH=usage.jsonl
# Monthly budget used for /usage reports and warning logs (AI Sandbox cap).
# MONTHLY_BUDGET_USD=250
# Pricing API base URL and local cache (refreshed every PRICING_TTL_HOURS).
# PRICING_BASE_URL=https://api.portkey.ai/model-configs
# PRICING_CACHE_PATH=.pricing_cache.json
# PRICING_TTL_HOURS=24
# gemini-3.8-flash is listed in the pricing catalog under this name.
# GEMINI38_FLASH_PRICING_MODEL=gemini-3.8-flash-gt-128k
# gpt-6.1-sol is listed in the pricing catalog as "gpt-6-sol"; without this the
# lookup 404s and those requests are logged without a cost.
# GPT6_SOL_PRICING_MODEL=gpt-6-sol
